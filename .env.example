# Copy to .env for local development. Never commit .env. Values below match docker-compose.dev.yml.
# Staging/production values live only in /opt/horeca/<env>/.env on the server (template: deploy/env.staging.example).

APP_ENV=local                      # local | staging | production
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# PostgreSQL — the image's superuser runs the init script once (empty data directory only),
# which creates the three logins and the database owned by horeca_owner (decision 9.4).
# deploy/postgres/init/01-roles.sh reads the three *_PASSWORD values below; the passwords inside the
# three URLs must match them. Changing them later needs a fresh volume: docker compose -f docker-compose.dev.yml down -v
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
POSTGRES_WORKER_PASSWORD=change-me
DATABASE_URL=postgresql://horeca_app:change-me@127.0.0.1:5432/horeca            # web (+ worker jobs acting for a user)
DATABASE_WORKER_URL=postgresql://horeca_worker:change-me@127.0.0.1:5432/horeca  # worker container only
DATABASE_MIGRATE_URL=postgresql://horeca_owner:change-me@127.0.0.1:5432/horeca  # migrate container only (non-superuser owner)

# Meilisearch (server-side only). Locally docker-compose.dev.yml uses MEILI_API_KEY as the MASTER key,
# so the app authenticates with the master key. On the server the app gets a scoped API key instead.
# Use at least 16 bytes.
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=change-me-local-master-key

# Better Auth
BETTER_AUTH_SECRET=change-me-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
REGISTRATION_OPEN=true

# Seed — required on production (never the README demo password there)
SEED_DEMO_PASSWORD=Demo-1234!

# Media files (product images in 3 WebP sizes, invoice PDFs) — S3-compatible storage, Garage in every
# environment (decision 013). Garage stays internal; locally its S3 API is on 127.0.0.1:3900.
# After `docker compose -f docker-compose.dev.yml up -d`, run scripts/garage-setup.sh once and paste the
# two key lines it prints below.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage                   # must match s3_region in deploy/garage/garage.toml
S3_BUCKET=horeca-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Garage's own secrets (read by the garage container only, never by the app).
# GARAGE_RPC_SECRET must be 64 hex characters: openssl rand -hex 32 (Garage refuses to start otherwise).
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=change-me-local-garage-admin-token

# E-mail — SMTP to Mailpit in every environment
EMAIL_FROM="HoReCa Marketplace <no-reply@localhost>"
SMTP_URL=smtp://127.0.0.1:1025

# mock-services (decision 012) — mock card gateway + supplier stock API in one app.
# Port 4010. Start it with `pnpm mock:dev` (separate terminal). The supplier stock API exists (D6-A3);
# the gateway under /gateway/ arrives with D10-B3, so PAYMENT_GATEWAY_URL points at nothing yet.
PAYMENT_GATEWAY_URL=http://127.0.0.1:4010/gateway
PAYMENT_GATEWAY_API_KEY=change-me-local-gateway-key
PAYMENT_WEBHOOK_SECRET=change-me-32-plus-random-characters   # HMAC-SHA256; mock-services must use the same value
SUPPLIER_API_URL=http://127.0.0.1:4010
SUPPLIER_API_KEY=change-me-local-supplier-key      # sent as "Authorization: Bearer …"; mock-services checks the same value
# mock-services' own settings (optional; read by mock-services only):
#   MOCK_SUPPLIER_BEHAVIOUR  JSON in SINGLE quotes, per supplier external code (= organization slug):
#                            normal (default) · down (503 on everything) · out_of_stock (listed SKUs are 0)
#   MOCK_DEFAULT_STOCK       quantity answered for a SKU outside the seed data (default 100)
# Changing them needs a restart of mock-services, which also resets its in-memory stock.
# MOCK_SUPPLIER_BEHAVIOUR='{"demo-supplier-b":{"mode":"down"},"demo-supplier-c":{"mode":"out_of_stock","skus":["HT-3001"]}}'
# MOCK_DEFAULT_STOCK=100

# AI features (stretch S3/S4) — off by default; on only for testing and the demo; server-side only
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
