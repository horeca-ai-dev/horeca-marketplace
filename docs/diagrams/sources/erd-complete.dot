digraph ERD {
graph [fontname="Inter" rankdir=TB splines=true nodesep=0.4 ranksep=0.9 pad=0.5 bgcolor=white newrank=true
       label=<<B>HoReCa B2B Marketplace — complete database (34 tables)</B><BR/><FONT POINT-SIZE="12" COLOR="#555555">Generated from the Drizzle schema of horeca-decisions-9-11. PK red · FK green · UQ purple · ? = nullable · money columns (bigint cents) highlighted · “→ organization” / “→ user” = foreign key to that Better Auth table (not drawn as a line)</FONT>> labelloc=t labeljust=l fontsize=22];
node [shape=plaintext fontname="Inter" fontsize=10];
edge [color="#555555" arrowhead=crow arrowtail=none dir=both penwidth=0.9];
