%% Decision 10 — catalogue. Source of truth: src/server/db/schema/catalogue.ts (migration 0003). Money = bigint cents; rates = bps.
%% Updated D4-B4 (26.11): width/height + csv filename/error_message from the real schema, media keys are S3 object keys (decision 013), supplier profiles are created as approved by the platform (decision 012).
erDiagram
  organization ||--|| org_profiles : "1:1 (identity, decision 3)"
  organization ||--o{ products : "supplier owns"
  organization ||--o{ csv_imports : "supplier runs"
  categories ||--o{ categories : "parent (max depth 3)"
  categories ||--o{ category_attributes : "defines (inherited by children)"
  categories ||--o{ products : "leaf category only"
  categories ||--o{ csv_imports : "one leaf category per file"
  products ||--o{ product_images : "0..8, position 0 = main"
  csv_imports |o--o{ products : "created / updated by"
  user ||--o{ csv_imports : "uploaded by"

  categories {
    uuid id PK
    uuid parent_id FK "NULL = root"
    ltree path UK "refrigeration.under_counter"
    text slug UK
    text name
    smallint depth "1..3"
    int position "order among siblings"
    bool is_active
  }
  category_attributes {
    uuid id PK
    uuid category_id FK
    text key "UK with category; unique along the ancestor path"
    text label
    enum type "number | enum | boolean | text"
    text unit "canonical unit: W, mm, l, kg, C"
    bool required
    bool filterable
    bool sortable
    jsonb options "enum values, add-only"
    numeric min_value "number only"
    numeric max_value "number only"
    int position
    bool is_active "deactivate instead of delete"
  }
  products {
    uuid id PK
    text supplier_org_id FK
    uuid category_id FK
    text sku "UK with supplier"
    text name
    text description
    text brand
    text gtin "optional EAN - compare offers"
    text mpn "manufacturer part number"
    enum unit "piece | box | pack | kg | l | m"
    int min_order_qty
    int order_step "qty must be a multiple"
    bigint base_price_cents "net"
    int vat_rate_bps "2100 = 21 percent"
    enum status "draft | active | archived"
    jsonb attributes "validated by generated Zod schema"
    uuid csv_import_id FK "NULL"
    timestamptz updated_at
  }
  product_images {
    uuid id PK
    uuid product_id FK
    text supplier_org_id FK "denormalised for RLS"
    smallint position "UK with product, 0..7"
    text alt
    text original_key "S3 object key (Garage bucket horeca-media); sizes 320/640/1280 WebP by convention, no thumb_key"
    text content_type "image/jpeg | image/png | image/webp (magic bytes)"
    int size_bytes "1 byte .. 5 MB"
    int width "NULL while pending, set by the image job"
    int height "NULL while pending, set by the image job"
    enum status "pending | ready | failed"
  }
  csv_imports {
    uuid id PK
    text supplier_org_id FK "one active import per supplier"
    uuid category_id FK
    text created_by_user_id FK
    text file_key "original file, S3 object key (private, through the app only)"
    text filename "as uploaded"
    enum status "uploaded - validating - validated - importing - completed | failed | cancelled"
    int total_rows "max 5000"
    int valid_rows
    int invalid_rows
    int created_count
    int updated_count "upsert by supplier + sku"
    jsonb report "row, column, message; max 1000 entries"
    text error_message "set when failed"
  }
  org_profiles {
    text organization_id PK
    enum type "buyer | supplier | platform"
    enum status "pending | approved | rejected | suspended (suppliers are created approved by the platform, decision 012)"
  }
