# Template for /opt/horeca/staging/.env on the server (owner deploy, mode 600). NEVER commit real values.
# Generate every secret with:  openssl rand -base64 33 | tr -d '/+=' | cut -c1-40
# Read by deploy/compose.yml (interpolation only — each container gets just the keys it needs).

# ── Compose ────────────────────────────────────────────────────────────────────────────────────
# also names the Compose project: horeca-staging
APP_ENV=staging
# 127.0.0.1:3101 → Nginx (production: 3102). deploy.sh reads it for the health check.
WEB_PORT=3101
# 127.0.0.1:8126 → Nginx /_mail/ (production: 8127)
MAILPIT_UI_PORT=8126
# Memory limits (staging + production share ≈ 4 GB; staging total ≈ 1.9 GB). Stop staging when not testing.
WEB_MEM_LIMIT=384m
WORKER_MEM_LIMIT=768m
POSTGRES_MEM_LIMIT=384m
MEILI_MEM_LIMIT=256m
MAILPIT_MEM_LIMIT=64m
MIGRATE_MEM_LIMIT=256m
GARAGE_MEM_LIMIT=128m
MOCK_SERVICES_MEM_LIMIT=96m

# ── App ────────────────────────────────────────────────────────────────────────────────────────
APP_URL=https://staging.horeca.bogdandelic.online
LOG_LEVEL=info

# ── PostgreSQL ─────────────────────────────────────────────────────────────────────────────────
# The init script creates the three logins from these ONCE (empty volume). Changing them later needs
# `staging-reset` (deletes all staging data). The passwords inside the URLs must match.
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_WORKER_PASSWORD=change-me-worker
DATABASE_URL=postgresql://horeca_app:change-me-app@postgres:5432/horeca
DATABASE_WORKER_URL=postgresql://horeca_worker:change-me-worker@postgres:5432/horeca
DATABASE_MIGRATE_URL=postgresql://horeca_owner:change-me-owner@postgres:5432/horeca

# ── Meilisearch ────────────────────────────────────────────────────────────────────────────────
# TODO(search): MEILI_API_KEY becomes a scoped key; for now it is the master key (≥ 16 bytes).
MEILI_MASTER_KEY=change-me-meili-master-key-40-chars
MEILI_HOST=http://meilisearch:7700
MEILI_API_KEY=change-me-meili-master-key-40-chars

# ── Better Auth ────────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_URL=https://staging.horeca.bogdandelic.online
BETTER_AUTH_SECRET=change-me-32-plus-random-characters-staging
REGISTRATION_OPEN=true

# ── Garage — S3 media storage, internal only (decision 013; README → One-time server setup) ─────
# Garage's own secrets, read by the garage container only.
# RPC secret: exactly 64 hex characters (openssl rand -hex 32) — Garage refuses to start otherwise.
GARAGE_RPC_SECRET=change-me-64-hex-characters-openssl-rand-hex-32
GARAGE_ADMIN_TOKEN=change-me-garage-admin-token
# The app's view (web + worker; backup.sh's rclone). Region = s3_region in deploy/garage/garage.toml.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=horeca-media
# Printed ONCE by scripts/garage-setup.sh. Keep these placeholders until then (Compose requires
# every key to be set, even to start Garage), then replace them and redeploy.
# staging-reset deletes Garage's volumes too: run the setup again and paste the NEW pair.
S3_ACCESS_KEY_ID=change-me-printed-by-garage-setup
S3_SECRET_ACCESS_KEY=change-me-printed-by-garage-setup
S3_FORCE_PATH_STYLE=true

# ── E-mail (Mailpit in the same project) ───────────────────────────────────────────────────────
EMAIL_FROM="HoReCa Marketplace (staging) <no-reply@staging.horeca.bogdandelic.online>"
SMTP_URL=smtp://mailpit:1025

# ── mock-services — its own container, internal only (no host port): http://mock-services:4010 ─
# Supplier stock API: built (D6-A3). SUPPLIER_API_KEY is shared by web, worker and mock-services:
# generate it (openssl rand -hex 32). The gateway values stay placeholders until D10-B3.
PAYMENT_GATEWAY_URL=http://mock-services:4010/gateway
PAYMENT_GATEWAY_API_KEY=change-me-staging-gateway-key
PAYMENT_WEBHOOK_SECRET=change-me-32-plus-random-characters-hmac
SUPPLIER_API_URL=http://mock-services:4010
SUPPLIER_API_KEY=change-me-staging-supplier-key
# mock-services' own settings (optional; read by mock-services only):
#   MOCK_SUPPLIER_BEHAVIOUR  JSON in SINGLE quotes, per supplier external code (= organization slug):
#                            normal (default) · down (503 on everything) · out_of_stock (listed SKUs are 0)
#   MOCK_DEFAULT_STOCK       quantity answered for a SKU outside the seed data (default 100)
# Changing them needs a restart of mock-services, which also resets its in-memory stock.
# MOCK_SUPPLIER_BEHAVIOUR='{"demo-supplier-b":{"mode":"down"},"demo-supplier-c":{"mode":"out_of_stock","skus":["HT-3001"]}}'
# MOCK_DEFAULT_STOCK=100

# ── AI (stretch) — off ─────────────────────────────────────────────────────────────────────────
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
